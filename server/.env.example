# Copy this file to .env and fill in your own values.

# MongoDB Atlas connection string (from Atlas > Connect > Drivers).
# Replace <username> and <password>, and keep /anvyra as the database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/anvyra?retryWrites=true&w=majority

# Or, for MongoDB installed on your own computer:
# MONGODB_URI=mongodb://127.0.0.1:27017/anvyra
