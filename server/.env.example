# Copy this file to .env and fill in your own values.

# MongoDB Atlas connection string (from Atlas > Connect > Drivers).
# Replace <username> and <password>, and keep /anvyra as the database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/anvyra?retryWrites=true&w=majority

# Or, for MongoDB installed on your own computer:
# MONGODB_URI=mongodb://127.0.0.1:27017/anvyra

# API port. 5001 because macOS uses 5000 for AirPlay.
PORT=5001

# Secret used to sign login tokens. Use any long random text.
JWT_SECRET=change-me-to-a-long-random-text

# --- Translation of Hindi / Telugu updates (optional, any of these) ---
# Without a key the matcher still works on the original words, but every Hindi/Telugu
# update is marked "needs check" for the officer.
# Providers are tried in this order: Groq, Gemini, Google Translate (only those with a key).
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# or Google Cloud Translation:
GOOGLE_TRANSLATE_KEY=
